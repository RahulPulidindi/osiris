# Osiris configuration — copy to .env and fill. NEVER commit .env.

# --- LLM ---
OPENROUTER_API_KEY=
# Hard stop on daily LLM spend. The default model set is budget-tier and a full
# research cycle costs ~$0.05-0.15, so $2 is generous headroom, not a constraint.
OSIRIS_LLM_DAILY_USD_CEILING=2.0

# Per-role model overrides (unset = budget defaults). Upgrade as the account
# grows, e.g.:
#   OSIRIS_MODEL_STRATEGIST=anthropic/claude-sonnet-4.5
#   OSIRIS_MODEL_RED_TEAM=openai/gpt-5
#   OSIRIS_MODEL_PM=anthropic/claude-sonnet-4.5

# --- Research (required for the agent to form new opinions) ---
# Exa powers stages 2-3 of the research funnel: filings and primary sources for
# the ~40 names that survive the cheap pre-rank. Without it the agent can still
# reconcile and manage exits, but produces no new theses.
EXA_API_KEY=

# NOTE: FRED_API_KEY was listed here previously and is NOT used by any code.
# Macro blackout windows (CPI/FOMC/NFP) are computed from a schedule in
# osiris/data/macro.py rather than fetched, so no macro data key is needed.
# Removed rather than left blank, since unused config invites the question of
# whether something is broken.

# --- Robinhood MCP ---
# OAuth 2.1 + PKCE is interactive on first run. Run `python -m osiris.connect`
# once; tokens are cached in ~/.osiris/mcp-auth.json (0600), never in this repo.
OSIRIS_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading

# Which account to trade. RECOMMENDED in production: your login can see several
# accounts (Individual, Roth, Agentic), and this removes all guessing. Find the
# number under Robinhood -> Account -> Investing, or run
# `python -m osiris.connect --debug-accounts`.
# Without a pin, Osiris picks the account marked Agentic, or refuses to start
# when several accounts are visible and none is identifiable.
OSIRIS_ACCOUNT_NUMBER=

# --- Account facts (Phase 0 output; see docs/PHASE0.md) ---
# One of: cash | margin | unknown. Governs turnover and sizing.
OSIRIS_ACCOUNT_TYPE=unknown
OSIRIS_ACCOUNT_EQUITY_USD=0

# --- Execution mode ---
# paper | live. Defaults to paper. `live` additionally requires
# OSIRIS_I_UNDERSTAND_THE_RISK=yes to arm the real order path.
OSIRIS_MODE=paper
OSIRIS_I_UNDERSTAND_THE_RISK=no

# --- Risk limits (fractions of equity unless noted) ---
OSIRIS_MAX_TRADE_NOTIONAL_PCT=0.02
OSIRIS_MAX_SYMBOL_WEIGHT=0.10
OSIRIS_MAX_SECTOR_WEIGHT=0.25
OSIRIS_MAX_SECTOR_DEVIATION=0.10
OSIRIS_MAX_PORTFOLIO_BETA=1.15
OSIRIS_MIN_POSITION_COUNT=15
OSIRIS_TARGET_POSITION_COUNT=20
OSIRIS_MAX_ADV_PARTICIPATION=0.01
OSIRIS_MAX_SPREAD_BPS=25.0
OSIRIS_DAILY_ORDER_BUDGET=60
OSIRIS_QUOTE_STALENESS_SECONDS=300
OSIRIS_EARNINGS_BLACKOUT_HOURS=48

# --- Circuit breakers ---
OSIRIS_DAILY_LOSS_HALT_PCT=0.03
OSIRIS_MAX_DRAWDOWN_HALT_PCT=0.10
OSIRIS_CONSECUTIVE_LOSS_HALT=5

# --- Continuous monitoring (the guardian) ---
# Position stop-loss, enforced every tick while the market is open.
OSIRIS_STOP_LOSS_PCT=0.15
# Seconds between ticks. Each tick is one quotes call for held names only.
OSIRIS_WATCH_INTERVAL_SECONDS=60

# --- Alerting (Phase 5) ---
# Any JSON webhook: Slack, Discord, ntfy, Pushover. Unset means log-only.
# Alert delivery failures are swallowed by design; they must never affect trading.
OSIRIS_ALERT_WEBHOOK=
# info | warning | critical. `critical` = breaker trips, reconciliation breaks,
# and kill-switch events only. `info` additionally pages on every fill.
OSIRIS_ALERT_MIN_SEVERITY=info
